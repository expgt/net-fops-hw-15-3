[webservers]
%{ for i in webservers ~}
${i["name"]} ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]} ansible_python_interpreter=/usr/bin/python3
%{ endfor ~}

[databases]
%{ for i in databases ~}
${i["name"]} ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]} ansible_python_interpreter=/usr/bin/python3
%{ endfor ~}

[storages]
%{ for i in storage ~}
${i["name"]} ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]} ansible_python_interpreter=/usr/bin/python3
%{ endfor ~}
